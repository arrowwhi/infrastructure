SERVICE_NAME=example-bot
SERVICE_VERSION=dev
ENVIRONMENT=local

TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_MODE=polling            # polling | webhook
# TELEGRAM_WEBHOOK_URL=https://bot.example.com/telegram/webhook
# TELEGRAM_WEBHOOK_SECRET=long-random-string

STATE_STORE=memory               # memory | redis | postgres
# REDIS_ADDR=localhost:6379
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=bot
# DB_PASSWORD=bot
# DB_DATABASE=bot

LOG_LEVEL=info
METRICS_EXPORTER=prometheus      # /metrics на ADMIN_PORT
ADMIN_PORT=9090
OTEL_ENABLED=false
